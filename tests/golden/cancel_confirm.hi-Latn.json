{
  "lang": "hi-Latn",
  "tenant": {
    "name": "Apex Clinic",
    "locale_default": "hi-Latn"
  },
  "setup": {
    "seed_booking": true
  },
  "steps": [
    {
      "send": {
        "text": "appointment cancel karna hai"
      },
      "expect": [
        {
          "kind": "buttons",
          "ids": [
            "cancel:confirm",
            "cancel:keep"
          ],
          "body_key": "cancel.prompt"
        }
      ]
    },
    {
      "send": {
        "tap": "cancel:confirm"
      },
      "expect": [
        {
          "kind": "text",
          "key": "cancel.done"
        }
      ]
    }
  ],
  "final": {
    "bookings_confirmed": 0,
    "bookings_cancelled": 1
  }
}
