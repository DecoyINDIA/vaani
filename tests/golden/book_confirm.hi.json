{
  "lang": "hi",
  "tenant": {
    "name": "Apex Clinic",
    "locale_default": "hi"
  },
  "steps": [
    {
      "send": {
        "text": "कल अपॉइंटमेंट बुक करना है"
      },
      "expect": [
        {
          "kind": "list",
          "button_key": "ui.choose_time",
          "body_key": "booking.picker_prompt",
          "min_rows": 1
        }
      ]
    },
    {
      "send": {
        "tap": "slot:first"
      },
      "expect": [
        {
          "kind": "buttons",
          "ids": [
            "booking:confirm",
            "booking:cancel"
          ],
          "body_key": "booking.confirm_prompt"
        }
      ]
    },
    {
      "send": {
        "tap": "booking:confirm"
      },
      "expect": [
        {
          "kind": "text",
          "key": "booking.booked"
        }
      ]
    }
  ],
  "final": {
    "bookings_confirmed": 1
  }
}
