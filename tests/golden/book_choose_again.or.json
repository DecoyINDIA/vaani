            "booking:confirm",
            "booking:cancel"
          ],
          "body_key": "booking.confirm_prompt"
        }
      ]
    },
    {
      "send": {
        "tap": "booking:cancel"
      },
      "expect": [
        {
          "kind": "list",
          "button_key": "ui.choose_time",
          "body_key": "booking.repick_prompt",
          "min_rows": 1
        }
      ]
    }
  ],
  "final": {
    "bookings_confirmed": 0
  }
}
