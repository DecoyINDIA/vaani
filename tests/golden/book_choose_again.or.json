{
  "lang": "or",
  "tenant": {
    "name": "Apex Clinic",
    "locale_default": "or"
  },
  "steps": [
    {
      "send": {
        "text": "କାଲି ଡାକ୍ତରଙ୍କ ସହ ଦେଖା କରିବି"
      },
      "expect": [
        {
