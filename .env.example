# Project Vaani — environment template. Copy to .env, never commit the real file.
# Grouped per TRD ADRs; every var here is read via app/config.py (pydantic-settings).

# --- App ---
APP_ENV=dev                       # dev | staging | prod
JWT_SECRET=                       # required outside dev: 32+ random characters
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
USE_MOCK_ADAPTERS=false            # true only in explicitly configured tests
USE_MOCK_LLM=false                 # dev/CI only; staging and prod reject it
ENABLE_VOICE=false                 # mount Exotel router and require telephony keys
ENABLE_PAYMENTS=false              # mount Razorpay router and require payment gateway keys
ENABLE_BILLING=false               # require Razorpay plan IDs and clinic GSTIN

# --- Datastore (ADR-03: MongoDB Atlas ap-south-1 + Redis) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.ap-south-1.mongodb.net/vaani
REDIS_URL=redis://redis:6379/0      # use localhost only for an explicit local override

# --- WhatsApp / BSP (ADR-04: Meta Cloud API via BSP) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
BSP_ACCESS_TOKEN=
BSP_WABA_ID=
BSP_PHONE_NUMBER_ID=
# Tenant documents reference per-clinic secret variable names; define one per clinic.
# VAANI_WA_TOKEN_CLINIC_SLUG=

# --- LLM (ADR-02: OpenRouter, model-pinned per node) ---
OPENROUTER_API_KEY=
# Small/cheap classifier model (temperature 0), frontier responder, and fallback provider.
LLM_MODEL_CLASSIFIER=
LLM_MODEL_RESPONDER=
LLM_MODEL_EMBEDDING=
LLM_MODEL_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=8.0
LLM_JSON_MODE=true
KB_TEXT_INDEX=kb_text
KB_VECTOR_INDEX=kb_vector
KB_EMBEDDING_DIMENSIONS=1536

# --- Voice (ADR-05, Phase 2: Exotel + Sarvam-first STT/TTS) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
VOICE_PUBLIC_BASE_URL=              # Public HTTPS origin, e.g. https://voice.example.com
STT_PROVIDER=sarvam                # sarvam | deepgram | google — set post bake-off
TTS_PROVIDER=sarvam                # sarvam | elevenlabs (English fallback)
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Payments (Razorpay: subscriptions, UPI Autopay, payment links) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_PRO_ID=

# --- Billing / GST (F-17) ---
XOLVER_GSTIN=
INVOICE_SAC_CODE=998313

# --- Observability ---
SENTRY_DSN=

# --- Ops ---
AUDIT_LOG_RETENTION_DAYS=90
MEDIA_PURGE_DAYS=30
