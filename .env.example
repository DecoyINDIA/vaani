# Project Vaani — environment template. Copy to .env, never commit the real file.
# Grouped per TRD ADRs; every var here is read via app/config.py (pydantic-settings).

# --- App ---
APP_ENV=dev                       # dev | staging | prod
JWT_SECRET=changeme
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Datastore (ADR-03: MongoDB Atlas ap-south-1 + Redis) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.ap-south-1.mongodb.net/vaani
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp / BSP (ADR-04: Meta Cloud API via BSP) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
BSP_ACCESS_TOKEN=
BSP_WABA_ID=
BSP_PHONE_NUMBER_ID=

# --- LLM (ADR-02: OpenRouter, model-pinned per node) ---
OPENROUTER_API_KEY=
LLM_MODEL_CLASSIFIER=              # small/cheap model, temp 0
LLM_MODEL_RESPONDER=               # frontier model
LLM_MODEL_FALLBACK_PROVIDER=       # second provider for failover

# --- Voice (ADR-05, Phase 2: Exotel + Sarvam-first STT/TTS) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
STT_PROVIDER=sarvam                # sarvam | deepgram | google — set post bake-off
TTS_PROVIDER=sarvam                # sarvam | elevenlabs (English fallback)
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Payments (Razorpay: subscriptions, UPI Autopay, payment links) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Billing / GST (F-17) ---
XOLVER_GSTIN=
INVOICE_SAC_CODE=998314

# --- Observability ---
SENTRY_DSN=

# --- Ops ---
AUDIT_LOG_RETENTION_DAYS=90
MEDIA_PURGE_DAYS=30
